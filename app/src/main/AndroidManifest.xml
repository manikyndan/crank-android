<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Required by Media3's download requirements checking, not by the app directly.

        DownloadManager gates every transfer on its Requirements, and evaluating
        Requirements(Requirements.NETWORK) reads the active network through
        ConnectivityManager — which needs ACCESS_NETWORK_STATE. Without it that read fails and
        the requirement is treated as unmet, so the manager accepts the request, records it as
        QUEUED, and then never starts the transfer: zero bytes, no error, forever. Every
        download therefore stalled at "Downloading" and no song ever reached the downloaded
        state, which is why the completed control was unreachable in practice.

        This is a normal permission: granted at install, never prompted for.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
        Held by ExoPlayer while playing and buffering (see PlayerModule's setWakeMode).

        Without it the CPU is allowed to suspend the moment the screen turns off, which stalls
        in-flight network reads — DNS resolution of the CDN host fails and playback dies with
        "UnknownHostException" even though the foreground service is still alive. The service
        keeps the *process* resident; the wake lock keeps the *radio work* running.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".CrankApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Crankandroid"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Crankandroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
