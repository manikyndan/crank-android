<?xml version="1.0" encoding="utf-8"?>
<!-- CRANK launcher background: Obsidian black with a faint red glow,
     matching DarkPalette background #000000 + accent #FA2D48. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#FF000000" />

    <!-- Soft red aura behind the foreground motif -->
    <path android:pathData="M54,54 m-42,0 a42,42 0 1,1 84,0 a42,42 0 1,1 -84,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="44">
                <item android:color="#FF4A0D16" android:offset="0.0" />
                <item android:color="#FF1A0508" android:offset="0.55" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Faint vinyl-groove rings for texture -->
    <path
        android:pathData="M54,54 m-30,0 a30,30 0 1,1 60,0 a30,30 0 1,1 -60,0"
        android:fillColor="#00000000"
        android:strokeColor="#FF141414"
        android:strokeWidth="1" />
    <path
        android:pathData="M54,54 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0"
        android:fillColor="#00000000"
        android:strokeColor="#FF101010"
        android:strokeWidth="1" />
</vector>
