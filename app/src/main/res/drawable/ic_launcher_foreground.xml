<?xml version="1.0" encoding="utf-8"?>
<!-- CRANK launcher foreground: red vinyl disc + hand crank + music note.
     Theme accent #FA2D48 on transparent; all artwork kept inside the
     adaptive-icon safe zone (central 72dp circle). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crank arm (metal) behind the disc edge -->
    <path
        android:pathData="M69,60 L82,60"
        android:fillColor="#00000000"
        android:strokeColor="#FFE5E5EA"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Vinyl disc -->
    <path
        android:pathData="M52,60 m-19,0 a19,19 0 1,1 38,0 a19,19 0 1,1 -38,0"
        android:fillColor="#FFFA2D48" />

    <!-- Disc groove -->
    <path
        android:pathData="M52,60 m-13.5,0 a13.5,13.5 0 1,1 27,0 a13.5,13.5 0 1,1 -27,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFC9182F"
        android:strokeWidth="1.5" />

    <!-- Top sheen arc -->
    <path
        android:pathData="M38.5,51.5 A19,19 0 0 1 52,41"
        android:fillColor="#00000000"
        android:strokeColor="#FFFF8A9B"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />

