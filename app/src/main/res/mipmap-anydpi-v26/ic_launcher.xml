<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (API 26+).

    The background is the same black the artwork sits on, so the two layers meet seamlessly and
    the mask's bleed area is invisible. The foreground carries the whole icon at 96% of the
    108dp canvas, which places it inside the 72dp guaranteed-visible area — so no mask shape
    (circle, squircle, rounded square, teardrop) can clip the mark or its glow.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
